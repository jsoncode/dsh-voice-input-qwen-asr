{
  "name": "dsh-voice-input-qwen-asr",
  "version": "0.1.1",
  "author": "jsoncode",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsoncode/dsh-voice-input-qwen-asr/issues"
  },
  "homepage": "https://github.com/jsoncode/dsh-voice-input-qwen-asr#readme",
  "description": "Voice input plugin (dual-face): mic button beside the composer send action, live recording bubble streaming PCM to a local Qwen3-ASR python service managed by the host, plus an ASR environment settings page (clone runtime/model repos, create venv, run server). Bilingual UI (zh/en)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "keywords": [
    "dsh-plugin",
    "dsh-voice-input-qwen-asr",
    "asr",
    "qwen3-asr"
  ],
  "repository": "github:jsoncode/dsh-voice-input-qwen-asr",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "check": "tsc -b --pretty false",
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -b && tsdown",
    "watch": "tsdown --watch",
    "verify": "node scripts/verify-client.mjs",
    "package": "npm run check && npm run build && npm run verify && npm pack",
    "release": "npm run check && npm run build && npm run verify && npm version patch -m \"release: v%s\" && git push --follow-tags",
    "publish:npm": "npm run check && npm run build && npm run verify && npm publish --access public"
  },
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./python/*": "./python/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "python",
    "cordis.patch.yml",
    "assets/logo.svg",
    "README.md",
    "README.zh.md"
  ],
  "dependencies": {
    "ws": "^8.21.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-cordis-client-runner"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "18.3.0",
    "@types/ws": "^8.5.10",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
